# Copy to backend/.env and fill in the key. Only the first line is required.
OPENROUTER_API_KEY=sk-or-v1-...

# Any OpenRouter model with tool-calling support works.
LLM_MODEL=anthropic/claude-sonnet-5
LLM_BASE_URL=https://openrouter.ai/api/v1

# Модели в выпадающем списке чата (через запятую). Нужна поддержка tool-calling.
LLM_MODELS=anthropic/claude-sonnet-5,anthropic/claude-opus-5,openai/gpt-5.6-terra,google/gemini-3.7-flash,deepseek/deepseek-chat-v3.1,qwen/qwen3-max

# Where the plan store lives (SQLite file, shared with the MCP server process).
PLAN_DB_PATH=data/plans.sqlite3

# Comma-separated origins allowed to call the API directly (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Safety rail: how many tool calls one chat turn may make before stopping.
MAX_TOOL_STEPS=10

# Sent to OpenRouter for usage attribution.
APP_URL=http://localhost:5173
APP_TITLE=Gantt Plan Agent
