# Copy to .env — docker-compose reads this file.
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=anthropic/claude-sonnet-5

# Host interface and port the app is served on. Keep BIND_HOST on loopback when
# nginx (or any proxy) terminates TLS in front; use 0.0.0.0 to publish directly.
BIND_HOST=127.0.0.1
PORT=8080
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
